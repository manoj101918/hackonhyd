# --- Hindsight (memory) ---
# Hindsight Cloud: https://api.hindsight.vectorize.io   |   self-hosted: http://localhost:8888
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=acme-incidents

# --- Groq (LLM, OpenAI-compatible) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b

# --- App ---
LOG_LEVEL=INFO
# Comma-separated origins allowed to call the API (the Vite dev server by default)
CORS_ORIGINS=http://localhost:5173
